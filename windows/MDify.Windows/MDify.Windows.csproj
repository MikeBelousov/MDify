<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <MDifyVariant Condition="'$(MDifyVariant)' == ''">Ocr</MDifyVariant>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(MDifyVariant)' == 'Ocr'">net8.0-windows10.0.17763.0</TargetFramework>
    <TargetFramework Condition="'$(MDifyVariant)' == 'Lite'">net8.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SupportedOSPlatformVersion Condition="'$(MDifyVariant)' == 'Ocr'">10.0.17763.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(MDifyVariant)' == 'Lite'">10.0.26100.0</SupportedOSPlatformVersion>
    <DefineConstants Condition="'$(MDifyVariant)' == 'Ocr'">$(DefineConstants);MDIFY_WINDOWS_OCR</DefineConstants>
    <DefineConstants Condition="'$(MDifyVariant)' == 'Lite'">$(DefineConstants);MDIFY_WINDOWS_LITE</DefineConstants>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(MDifyVariant)' == 'Lite'">true</WindowsAppSDKSelfContained>
    <AssemblyName>MDify.Windows</AssemblyName>
    <RootNamespace>MDify.Windows</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <AppxOSMaxVersionTestedReplaceManifestVersion>false</AppxOSMaxVersionTestedReplaceManifestVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Condition="'$(MDifyVariant)' == 'Lite'" Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(MDifyVariant)' == 'Ocr'">
    <Compile Remove="Services\INativeOcrService.cs" />
    <Compile Remove="Services\NativeOcrRoutingClient.cs" />
    <Compile Remove="Services\WindowsNativeOcrService.cs" />
    <None Remove="Package.appxmanifest" />
  </ItemGroup>
</Project>
